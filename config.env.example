# Database (Supabase PostgreSQL Connection Pooler - Required for Docker IPv4 compatibility)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI -> Mode: Session
DATABASE_URL = "postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Settings
JWT_SECRET = "samarthya-secret-key-change-in-production-2026"
JWT_ALGORITHM = "HS256"
JWT_EXPIRE_MINUTES = "1440"

# Backend
BACKEND_HOST = "0.0.0.0"
BACKEND_PORT = "5173"
UPLOAD_DIR = "uploads"

# Frontend
VITE_API_URL = "http://localhost:5173/api"

# OpenAI / LLM Configuration (supports official OpenAI, OpenRouter, Groq, Ollama, LM Studio, etc.)
OPENAI_API_KEY = "your-openai-api-key-here"
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL_ID = "gpt-4o-mini"

# CORS
CORS_ORIGINS = "http://localhost:8005,http://localhost:3000"
