# Version Control
.git/
.gitignore

# Dependencies & Environments
**/node_modules/
**/venv/
**/.venv/
**/__pycache__/
**/*.py[cod]

# Builds
**/dist/
**/build/

# Secrets & Configs
.env
.env.*
config.env
*.env
!*.env.example
!config.env.example

# Local Data
**/uploads/*
!**/uploads/.gitkeep
**/*.db
**/*.sqlite3

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
